+/* A one-to-one UNORM color blit samples texel centers without conversion.
+ * Preserve those texels directly using the existing copy path. Scaling, flips,
+ * sRGB, depth, 3D and extension chains retain the filtered implementation.
+ * This is independent of application names, title IDs and shader hashes.
+ */
+static bool
+xclipse_blit_is_exact_copy(const struct radv_image *src, const struct radv_image *dst,
+                           const VkBlitImageInfo2 *info)
+{
+   if (info->pNext || info->regionCount != 1 || info->srcImage == info->dstImage ||
+       (info->filter != VK_FILTER_NEAREST && info->filter != VK_FILTER_LINEAR) ||
+       src->vk.image_type != VK_IMAGE_TYPE_2D || dst->vk.image_type != VK_IMAGE_TYPE_2D ||
+       src->vk.samples != VK_SAMPLE_COUNT_1_BIT || dst->vk.samples != VK_SAMPLE_COUNT_1_BIT ||
+       src->vk.format != dst->vk.format ||
+       (src->vk.format != VK_FORMAT_R8G8B8A8_UNORM && src->vk.format != VK_FORMAT_B8G8R8A8_UNORM))
+      return false;
+
+   const VkImageBlit2 *r = &info->pRegions[0];
+   if (r->pNext || r->srcSubresource.aspectMask != VK_IMAGE_ASPECT_COLOR_BIT ||
+       r->dstSubresource.aspectMask != VK_IMAGE_ASPECT_COLOR_BIT ||
+       vk_image_subresource_layer_count(&src->vk, &r->srcSubresource) !=
+          vk_image_subresource_layer_count(&dst->vk, &r->dstSubresource) ||
+       r->srcOffsets[0].z != 0 || r->srcOffsets[1].z != 1 ||
+       r->dstOffsets[0].z != 0 || r->dstOffsets[1].z != 1)
+      return false;
+
+   const int32_t sx = r->srcOffsets[1].x - r->srcOffsets[0].x;
+   const int32_t sy = r->srcOffsets[1].y - r->srcOffsets[0].y;
+   const int32_t dx = r->dstOffsets[1].x - r->dstOffsets[0].x;
+   const int32_t dy = r->dstOffsets[1].y - r->dstOffsets[0].y;
+   return sx > 0 && sy > 0 && sx == dx && sy == dy;
+}
+
